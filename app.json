{
  "expo": {
    "name": "NewNET LIVE Real",
    "slug": "newnet-live-real",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "com.newnet.live",
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for LIVE"
        }
      ]
    ]
  }
}
